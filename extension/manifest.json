{
  "manifest_version": 3,
  "name": "Overleaf Resume Optimizer",
  "version": "0.1.0",
  "description": "Tailor an Overleaf LaTeX resume to a job description using Claude CLI running locally.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.overleaf.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Resume Optimizer — click to open on an Overleaf project"
  },
  "content_scripts": [
    {
      "matches": ["https://*.overleaf.com/project/*"],
      "js": ["content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.overleaf.com/project/*"],
      "js": ["cm-bridge.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
